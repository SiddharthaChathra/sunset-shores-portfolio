# Companion assistant (server-side only; never exposed to the browser)
GROQ_API_KEY=
# Optional: a Groq *model id*, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile.
# Leave blank for the default. (Not the word "groq".)
GROQ_MODEL=
# Public URL used for metadata, sitemap and OG tags
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
